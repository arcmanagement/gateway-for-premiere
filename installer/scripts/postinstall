#!/bin/sh
set -u

# LaunchAgent setup is a convenience. The package is already installed by the
# time this runs, so every failure here is reported to the install log and the
# script still exits 0 instead of showing a generic installation failure.

INSTALL_ROOT="/usr/local/lib/gateway-for-premiere"
ENTRYPOINT="$INSTALL_ROOT/dist/cli/index.js"

skip() {
  echo "$1" >&2
  echo "Run 'gateway-for-premiere daemon install' to start the local broker." >&2
  exit 0
}

CONSOLE_USER=$(/usr/bin/stat -f '%Su' /dev/console 2>/dev/null || echo "")

case "$CONSOLE_USER" in
  "" | root | loginwindow)
    skip "No signed-in desktop user was found; skipping LaunchAgent setup."
    ;;
esac

USER_ID=$(/usr/bin/id -u "$CONSOLE_USER" 2>/dev/null || echo "")
[ -n "$USER_ID" ] || skip "Could not resolve the user ID for $CONSOLE_USER."

USER_HOME=$(/usr/bin/dscl . -read "/Users/$CONSOLE_USER" NFSHomeDirectory 2>/dev/null | /usr/bin/awk '{print $2}')
[ -n "$USER_HOME" ] || skip "Could not resolve the home directory for $CONSOLE_USER."

MACHINE_ARCH=$(/usr/bin/uname -m)

case "$MACHINE_ARCH" in
  arm64) NODE="$INSTALL_ROOT/runtime/arm64/bin/node" ;;
  x86_64) NODE="$INSTALL_ROOT/runtime/x64/bin/node" ;;
  *) skip "Unsupported Mac architecture: $MACHINE_ARCH." ;;
esac

[ -x "$NODE" ] || skip "The bundled Node runtime is missing at $NODE."
[ -f "$ENTRYPOINT" ] || skip "The CLI entry point is missing at $ENTRYPOINT."

if /bin/launchctl asuser "$USER_ID" /usr/bin/sudo -H -u "$CONSOLE_USER" \
  /usr/bin/env HOME="$USER_HOME" PATH="/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin" \
  "$NODE" "$ENTRYPOINT" daemon install >/dev/null; then
  exit 0
fi

echo "Automatic LaunchAgent setup did not complete for $CONSOLE_USER." >&2
echo "Run 'gateway-for-premiere daemon install' in Terminal, then 'gateway-for-premiere doctor'." >&2
exit 0
